{
  "name": "store-autohide",
  "private": true,
  "// packageManager": "Pins the pnpm corepack resolves — without it the Docker build picks a newer pnpm than the host and rejects this lockfile.",
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter server dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "db:push": "pnpm --filter server db:push",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:studio": "pnpm --filter server db:studio",
    "db:seed": "pnpm --filter server db:seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "bcrypt"
    ]
  }
}

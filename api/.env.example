# --- App ---
APP_NAME=storeAutoHide
ENV=dev

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=storeautohide

# --- JWT (portal auth: sellers + admins) ---
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Flowdesk auth/device server (end-user identity + app usage) ---
FLOWDESK_BASE_URL=https://flowdesk.hachitechsolution.com/api
# Optional service token if the flowdesk admin/device endpoints require one:
FLOWDESK_SERVICE_TOKEN=

# --- Artifact storage (uploaded packages + extracted workflow graphs) ---
# Directory the API writes scrubbed graphs into (relative paths resolve from the api/ dir).
STORAGE_DIR=var/storage
# Hard limit for a single upload, in bytes (default 200 MB).
MAX_UPLOAD_BYTES=209715200
# Zipped empty mini-app (packaged hideflow app without a workflow). Needed to repackage
# downloads as .zip; leave unset and only graph downloads work.
MINI_APP_TEMPLATE_PATH=

# --- Seller onboarding ---
# true = seller đăng ký xong là dùng được ngay (bỏ bước admin duyệt).
# CHỈ dùng khi dev — bật ở production nghĩa là ai cũng đăng được script lên store.
SELLER_AUTO_APPROVE=false

# --- Initial admin (seeded on startup if no admin exists) ---
INITIAL_ADMIN_EMAIL=admin@storeautohide.local
INITIAL_ADMIN_PASSWORD=change-me-too

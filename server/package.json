{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "pnpm test:graph && pnpm test:license && pnpm test:keys",
    "test:graph": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} test/workflow-graph.test.ts",
    "test:license": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} test/license.test.ts",
    "test:keys": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} test/key-code.test.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} src/seed.ts",
    "db:seed:demo": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} src/seed-demo.ts",
    "db:seed:demo:clear": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} src/seed-demo.ts --clear"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "sanitize-html": "^2.17.7",
    "slugify": "^1.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.0",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.5",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0"
  }
}

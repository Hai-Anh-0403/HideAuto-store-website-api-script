generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Identity ────────────────────────────────────────────────

enum Role {
  ADMIN
  SELLER
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model Seller {
  id        String       @id @default(cuid())
  email     String       @unique
  name      String
  password  String
  contact   String?
  status    SellerStatus @default(PENDING)
  /// Why the admin rejected or suspended the account — shown to the seller on sign-in.
  statusReason String?   @map("status_reason")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  scripts  Script[]
  keys     SellerKey[]
  members  SellerMember[]
  sessions SellerSession[]

  @@map("sellers")
}

model SellerSession {
  id         String   @id @default(cuid())
  sellerId   String   @map("seller_id")
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  jti        String   @unique
  device     String?
  userAgent  String?  @map("user_agent")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")

  @@map("seller_sessions")
}

// ─── Catalog ────────────────────────────────────────────────────────

enum ScriptStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ScriptVersionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Tag {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String?
  createdAt   DateTime @default(now()) @map("created_at")

  scripts Script[] @relation("ScriptTags")

  @@map("tags")
}

model Script {
  id               String       @id @default(cuid())
  slug             String       @unique
  name             String
  shortDescription String?      @map("short_description")
  description      String?      @db.Text
  videoUrl         String?      @map("video_url")
  thumbnailUrl     String?      @map("thumbnail_url")
  /// JSON array of image URL strings.
  images           Json         @default("[]")
  sellerId         String       @map("seller_id")
  seller           Seller       @relation(fields: [sellerId], references: [id])
  sellerName       String       @map("seller_name")
  engine           String       @default("hideflow")
  hasMiniApp       Boolean      @default(false) @map("has_mini_app")

  latestVersion   String?  @map("latest_version")
  latestVersionId String?  @map("latest_version_id")
  minAppVersion   String?  @map("min_app_version")
  nodeCount       Int      @default(0) @map("node_count")
  /// JSON array of strings. MySQL has no scalar lists; read it through toStringArray().
  nodeGroupsUsed  Json     @default("[]") @map("node_groups_used")
  capabilities    Json     @default("{}")

  status       ScriptStatus @default(DRAFT)
  rejectReason String?      @map("reject_reason")

  ratingAvg   Float @default(0) @map("rating_avg")
  ratingCount Int   @default(0) @map("rating_count")
  downloads   Int   @default(0)
  views       Int   @default(0)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  publishedAt DateTime? @map("published_at")

  tags     Tag[]           @relation("ScriptTags")
  versions ScriptVersion[]
  keys     SellerKey[]
  builds   MiniAppBuild[]

  @@index([sellerId, createdAt(sort: Desc)])
  @@index([status])
  @@index([ratingAvg(sort: Desc)])
  @@map("scripts")
}

model ScriptVersion {
  id              String              @id @default(cuid())
  scriptId        String              @map("script_id")
  script          Script              @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  version         String
  changelog       String?
  fileUrl         String?             @map("file_url")
  sourceFilename  String?             @map("source_filename")
  sourceChecksum  String?             @map("source_checksum")
  delivery        String              @default("graph_json")
  formatVersion   Int                 @default(1) @map("format_version")
  minAppVersion   String?             @map("min_app_version")
  testedAppVersion String?            @map("tested_app_version")

  graphExtracted  Boolean             @default(false) @map("graph_extracted")
  nodeCount       Int                 @default(0) @map("node_count")
  /// JSON array of strings — see the note on Script.nodeGroupsUsed.
  nodeGroupsUsed  Json                @default("[]") @map("node_groups_used")
  usesControlFlow Boolean             @default(false) @map("uses_control_flow")
  /// JSON array of strings.
  subWorkflowIds  Json                @default("[]") @map("sub_workflow_ids")
  capabilities    Json                @default("{}")
  requiredVars    Json                @default("[]") @map("required_vars")
  scan            Json                @default("{}")

  appId   String? @map("app_id")
  appName String? @map("app_name")

  status     ScriptVersionStatus @default(PENDING_REVIEW)
  reviewedBy String?             @map("reviewed_by")
  reviewedAt DateTime?           @map("reviewed_at")
  reviewNote String?             @map("review_note")
  scannedAt  DateTime?           @map("scanned_at")
  releasedAt DateTime?           @map("released_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  @@unique([scriptId, version])
  @@map("script_versions")
}

// ─── Keys & Members ─────────────────────────────────────────────────

enum KeyStatus {
  ACTIVE
  REVOKED
}

enum MemberStatus {
  ACTIVE
  BLOCKED
}

model SellerKey {
  id       String  @id @default(cuid())
  sellerId String  @map("seller_id")
  seller   Seller  @relation(fields: [sellerId], references: [id])
  /// null = shop-wide key: redeeming it unlocks every app from this seller.
  ///
  /// ⚠ Cascade, not the default SetNull: a key whose app was deleted would otherwise turn
  /// into a shop-wide key and quietly unlock everything the seller sells.
  scriptId String? @map("script_id")
  script   Script? @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  key       String    @unique
  label     String?
  status    KeyStatus @default(ACTIVE)
  maxUses   Int?      @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  redemptions KeyRedemption[]

  @@index([sellerId])
  @@index([scriptId])
  @@map("seller_keys")
}

/// Who turned a key into access, and when.
///
/// `SellerKey.usedCount` only ever said *how many* — which left the seller unable to answer
/// "who used the key I sold to that reseller?". One row per (key, buyer): re-entering the
/// same key on a new machine does not add a row, so the count of rows is the count of
/// buyers, not of installs.
model KeyRedemption {
  id       String       @id @default(cuid())
  keyId    String       @map("key_id")
  key      SellerKey    @relation(fields: [keyId], references: [id], onDelete: Cascade)
  memberId String       @map("member_id")
  member   SellerMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// What this redemption unlocked; null when the key was shop-wide.
  scriptId  String?  @map("script_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([keyId, memberId])
  @@index([memberId])
  @@map("key_redemptions")
}

model SellerMember {
  id             String       @id @default(cuid())
  sellerId       String       @map("seller_id")
  seller         Seller       @relation(fields: [sellerId], references: [id])
  userId         String       @map("user_id")
  userEmail      String?      @map("user_email")
  userName       String?      @map("user_name")
  status         MemberStatus @default(ACTIVE)
  allScripts     Boolean      @default(false) @map("all_scripts")
  lastSeenAt     DateTime?    @map("last_seen_at")
  /// JSON array of machine ids.
  blockedDevices Json         @default("[]") @map("blocked_devices")
  redeemedAt     DateTime     @default(now()) @map("redeemed_at")

  /// JSON array of script ids.
  scriptIds Json     @default("[]") @map("script_ids")

  redemptions KeyRedemption[]
  devices     MemberDevice[]

  @@unique([sellerId, userId])
  @@index([sellerId])
  @@map("seller_members")
}

/// One machine a buyer has activated a mini app on.
///
/// `SellerMember.blockedDevices` decides which machine ids stop getting licences, but
/// nothing used to *tell the seller a machine id exists* — the block list could only ever be
/// empty. Every activation upserts its row here, so the portal can show real devices with a
/// block button next to each.
model MemberDevice {
  id       String       @id @default(cuid())
  memberId String       @map("member_id")
  member   SellerMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  machineId String @map("machine_id")
  /// The app most recently activated from this machine.
  scriptId  String? @map("script_id")

  activationCount Int      @default(0) @map("activation_count")
  firstSeenAt     DateTime @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")

  @@unique([memberId, machineId])
  @@index([memberId])
  @@map("member_devices")
}

// ─── Mini App Builds ────────────────────────────────────────────────

enum BuildStatus {
  BUILDING
  READY
  FAILED
}

model MiniAppBuild {
  id              String      @id @default(cuid())
  scriptId        String      @map("script_id")
  script          Script      @relation(fields: [scriptId], references: [id])
  scriptVersionId String      @map("script_version_id")
  appId           String      @map("app_id")
  appName         String      @map("app_name")
  appVersion      String      @map("app_version")
  platform        String      @default("win")
  arch            String      @default("x64")
  installerFormat String      @default("exe") @map("installer_format")
  sizeBytes       Int         @default(0) @map("size_bytes")
  checksum        String?
  fileUrl         String?     @map("file_url")
  status          BuildStatus @default(BUILDING)
  builtBy         String      @default("server") @map("built_by")
  error           String?
  builtAt         DateTime?   @map("built_at")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([scriptId])
  @@map("mini_app_builds")
}

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/store_autohide
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
PORT=3001

# Where scrubbed graphs and build artifacts are written (content-addressed).
STORAGE_DIR=var/storage

# Optional: bootstrap admin created by `pnpm db:seed`. Omit to skip the admin seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

DATABASE_URL=mysql://store:store@localhost:3306/store_autohide
MONGO_URI=mongodb://localhost:27017/hide_auto
MONGO_API_PORT=3002
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
PORT=3001

# Whose `x-forwarded-for` to believe when deciding the client address (rate-limit buckets,
# the session device list). Empty/false = believe nobody, use the socket address. Set it to
# your proxy's IP or CIDR (e.g. `10.0.0.0/8`) — or a hop count — only when that proxy
# *overwrites* the header; a proxy that forwards the client's own value lets callers pick
# their own bucket.
TRUST_PROXY=

# Where scrubbed graphs and build artifacts are written (content-addressed).
STORAGE_DIR=var/storage

# Bootstrap admin, created by `pnpm db:seed` (and automatically on container startup).
# Omit to skip it — but then nobody can approve sellers. An existing admin is never
# overwritten, so changing these later does not reset a password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Mini-app packaging ──────────────────────────────────────────────────
# A packaged-but-empty hideflow build (zipped, no resources/app.workflow). Without it the
# store can still serve the raw graph, but cannot repackage a .zip.
MINI_APP_TEMPLATE_PATH=

# Baked into every package so the installed app knows where to call home.
STORE_PUBLIC_URL=http://localhost:3001

# ── Mini-app licensing ──────────────────────────────────────────────────
# base64 of a raw 32-byte Ed25519 seed. Empty = no licence gate: packages open freely.
# Generate one with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({format:'der',type:'pkcs8'}).subarray(16).toString('base64'))"
# ⚠️ Rotating this invalidates every package already downloaded — they carry the old public key.
LICENSE_SIGNING_KEY=
# Licence lifetime = how long a buyer can stay offline = how long a revocation takes to bite.
LICENSE_TTL_DAYS=7

# ── Buyer accounts ──────────────────────────────────────────────────────
# End users authenticate against flowdesk, not the store. Must already include /api.
FLOWDESK_BASE_URL=https://flowdesk.hachitechsolution.com/api

# ── Demo data (dev only) ────────────────────────────────────────────────
# Overrides for `pnpm db:seed:demo`, which creates one APPROVED seller with fake
# scripts, keys and members. Defaults: seller@local.test / seller12345.
# Never run that seed against anything reachable.
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NAME=

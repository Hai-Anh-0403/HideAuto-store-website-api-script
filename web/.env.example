# Where the browser's same-origin `/api/*` calls are proxied to.
# ⚠️ Build-time only: Next compiles rewrites into routes-manifest.json, so setting this
# at runtime does nothing. Docker takes it as a build arg (see web/Dockerfile).
#   local dev: http://localhost:3001 · compose: http://server:3001
API_ORIGIN=http://localhost:3001

# Public origin of the portal, used as `metadataBase` so Open Graph and icon URLs in the
# page head resolve to absolute links. Also build-time (`NEXT_PUBLIC_*` is inlined).
# Getting it wrong only affects link previews — set it for a real deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
